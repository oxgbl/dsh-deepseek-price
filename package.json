{
  "name": "dsh-deepseek-price",
  "version": "0.1.0",
  "description": "DeepSeek 价格区间计时工具：侧边栏高峰/空闲定价徽标 + 距半价倒计时 + 点击详情面板 + /price 命令，依据官方峰谷分时定价（北京时间 9:00-12:00、14:00-18:00 为高峰，其余空闲半价）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxgbl/dsh-deepseek-price.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "README.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "plugin",
    "pricing",
    "peak",
    "off-peak"
  ]
}
